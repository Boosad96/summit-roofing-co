# Summit Roofing Co. — environment variables.
# Copy to `.env` and fill in. NEVER commit a real `.env` or API key.
# All WHOP_* values come from the Whop dashboard (see README.md).

# Server-only. Account API key with these permissions:
#   checkout_configuration:create, plan:create, access_pass:create,
#   access_pass:update, lead:manage, member:email:read, member:basic:read,
#   access_pass:basic:read, invoice:create, payment:charge
# Test with the SANDBOX key first (sandbox.whop.com/dashboard/developer).
WHOP_API_KEY=
# Optional override: the Whop runtime injects its own WHOP_API_KEY and the CLI refuses that name as a secret. Set this to point a deployed site at a different (for example sandbox) key.
WHOP_API_KEY_OVERRIDE=

# Your Whop account id, e.g. biz_xxxxxxxxxxxxx (dashboard URL).
WHOP_ACCOUNT_ID=
# Override for the reserved WHOP_ACCOUNT_ID (see the note on WHOP_API_KEY_OVERRIDE above).
WHOP_ACCOUNT_ID_OVERRIDE=

# API base: production https://api.whop.com/api/v1 (default),
# sandbox https://sandbox-api.whop.com/api/v1
WHOP_API_BASE=https://api.whop.com/api/v1

# Pinned API version. Native invoices need 2026-10-24 or later.
WHOP_API_VERSION=2026-10-24

# Plan ids (plan_…) — create the three plans in the Whop dashboard first.
# These are public identifiers, safe to expose to the browser via /api/config.
WHOP_PLAN_INSPECTION_ID=plan_REPLACE_WITH_INSPECTION
WHOP_PLAN_DEPOSIT_ID=plan_REPLACE_WITH_DEPOSIT
WHOP_PLAN_GUTTER_ID=plan_REPLACE_WITH_GUTTER
WHOP_PLAN_REPAIR_ID=plan_REPLACE_WITH_REPAIR
WHOP_PLAN_REPLACEMENT_ID=plan_REPLACE_WITH_REPLACEMENT

# Optional: the Whop product id (prod_…) the plans belong to. Used for the
# final-balance invoice item; without it the item is a custom fee.
WHOP_PRODUCT_ID=

# Optional: the Whop user id (user_...) a lead is recorded against when the
# estimate visitor is not signed in to Whop. The Leads API needs a real Whop
# user id: signed-in visitors use their own id, anonymous visitors fall back
# to this one. Find yours in the dashboard (Members) or via GET /members.
WHOP_LEAD_USER_ID=

# Port the server listens on (Whop hosting sets this itself).
PORT=3000
